config BOARD_ENABLE_DCDC
    bool "Enable DCDC mode"
    select SOC_DCDC_NRF52X
    default y
    depends on BOARD_PAWPAW

# Pawpaw runs in high-voltage mode: VDDH from VBUS/battery, VDD from the
# nRF52840's internal REG0. REGOUT0 is set to 3.3V by the bootloader.
config BOARD_ENABLE_DCDC_HV
    bool "High voltage DCDC converter"
    select SOC_DCDC_NRF52X_HV
    default y
    depends on BOARD_PAWPAW
